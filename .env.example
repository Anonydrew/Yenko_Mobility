# ─── App ──────────────────────────────────────────────────────────────
# "development" or "production". Production forces Secure cookies.
APP_ENV=development
# Show real error messages in API responses (never enable in production).
APP_DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────
# "sqlite" (default, zero setup) or "mysql".
DB_DRIVER=sqlite
# SQLite file. Relative paths are resolved from the backend folder.
DB_SQLITE_PATH=database/yenko.sqlite

# MySQL settings (only used when DB_DRIVER=mysql).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yenko
DB_USER=root
DB_PASSWORD=

# ─── Auth ─────────────────────────────────────────────────────────────
# At least 32 characters. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=replace-this-with-a-long-random-string-of-64-chars
# How long an admin session lasts.
JWT_TTL_MINUTES=480
# Send the session cookie over HTTPS only. Defaults to true when APP_ENV=production.
COOKIE_SECURE=false

# The single admin account. Run `composer seed` again after changing these.
ADMIN_EMAIL=admin@yenkomobility.com
ADMIN_PASSWORD=change-me-please-2026

# ─── Admin panel ──────────────────────────────────────────────────────
# URL path of the admin panel, e.g. https://yenkomobility.com/login-yenkoadmin
# (Only VITE_-prefixed values are ever sent to the browser.)
VITE_ADMIN_PATH=/login-yenkoadmin

# ─── Uploads ──────────────────────────────────────────────────────────
UPLOAD_MAX_MB=5
# Folder for uploaded images (served at /uploads). Relative paths are resolved from the backend folder.
UPLOAD_PATH=public/uploads

# ─── Networking ───────────────────────────────────────────────────────
# Only needed if the frontend is served from a different origin than the API
# (comma-separated, e.g. https://yenkomobility.com). The Vite dev proxy doesn't need it.
CORS_ALLOWED_ORIGINS=
# Set to true behind a reverse proxy / load balancer so rate limits use X-Forwarded-For.
TRUST_PROXY=false
