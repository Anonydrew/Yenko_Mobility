{
    "name": "yenko/backend",
    "description": "Yenko Mobility API: blog, categories, contact form and admin.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Yenko\\": "src/"
        }
    },
    "scripts": {
        "migrate": "php database/migrate.php",
        "migrate:fresh": "php database/migrate.php --fresh",
        "seed": "php database/seed.php",
        "serve": "php -d upload_max_filesize=8M -d post_max_size=10M -S 127.0.0.1:8000 -t public public/router.php"
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0
    }
}
